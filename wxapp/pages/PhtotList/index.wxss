.mian {
   background: #fff;
   padding-top: 25vh;
}

page {
   background: #f1f1f1 !important;
}

.PhotoCont-Warp {
   background: #f1f1f1;
   position: relative;
   padding: 30rpx 30rpx;
   border-radius: 30rpx;
   display: flex;
   justify-content: space-between;
   /* flex-wrap: wrap; */
   /* column-count: 2; */
}

.left-column,
.right-column {
   width: 49%;
}

.container {
   /* margin: 0 20rpx; */
   /* width: 48%; */
   margin-bottom: 20rpx;
   background: #fff;
   border-radius: 20rpx;
   box-shadow: 0 3px 30px #cacaca52;
   break-inside: avoid;
   -webkit-column-break-inside: avoid;
}

.container .photo_img,
.container .photo_video {
   width: 100%;
   border-radius: 20rpx 20rpx 0 0;
   display: block;
   position: relative;
}

.container .photo_img::before,
.container .photo_video::before {
   content: '';
   width: 100%;
   height: 30%;
   position: absolute;
   bottom: 0;
   left: 0;
   z-index: 100;
   pointer-events: none;
   background: linear-gradient(to top, #fff, transparent);
}


.container .text {
   padding: 10rpx 20rpx;
   box-sizing: border-box;
   display: flex;
   justify-content: space-between;
   align-items: flex-end;
}

.container .desc {
   position: relative;
   color: #7296fe;
   color: #3e3e3e;
   font-size: .85em;
   letter-spacing: 1rpx;
   line-height: 1.5em;
   font-weight: 400;
}

