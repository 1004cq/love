.container .date {
   color: #888;
   text-align: right;
   padding-right: 10rpx;
   font-size: .8em;
}

.container .byname {
   text-align: right;
   padding: 5rpx 10rpx;
   font-size: .8em;
}

.container .byname text {
   background: #333;
   padding: 5rpx 16rpx 6rpx;
   color: #fff !important;
   border-radius: 10rpx;
   display: inline-flex;
   line-height: 1.2em;
}

.left-column .container .byname,
.left-column .container .date {
   text-align: left;
   padding-left: 10rpx;
}

.container .byname text {
   color: #555;
}

.container .up_avatar {
   background: #ededed;
   width: 50rpx;
   height: 50%;
   border-radius: 50%;
   position: absolute;
   left: 10rpx;
   top: 50%;
   transform: translateY(-50%);
}

.left-column .container .up_avatar {
   left: inherit;
   right: 10rpx;
}

.err {
   width: 100%;
   margin-top: 25vh;
   display: flex;
   flex-direction: column;
   justify-content: center;
   align-items: center;
   font-size: 40rpx;
   color: rgb(240, 72, 100);
   animation: fadeIn 1.5s linear;
}

@keyframes fadeIn {
   0% {
      opacity: 0;
      transform: scale(0);
   }

   70% {
      transform: scale(1);
   }

   100% {
      opacity: 1;
   }
}

.err text {
   color: rgb(240, 72, 100);
   font-size: 300rpx;
   margin-bottom: 20rpx;
}

.photo_footer {
   width: 90%;
   margin: 0 auto;
   border-top: 2rpx dashed rgb(185, 181, 181);
   padding-bottom: 20rpx;
   padding-top: 15rpx;
   font-size: .9em;
   position: relative;
}

.PhotoCover {
   position: fixed;
   width: 100%;
}

.PhotoCover .PhotoDataHead {
   position: absolute;
   top: 200rpx;
   width: 100%;
   display: flex;
   padding: 20rpx 50rpx;
   align-items: center;
   gap: 20rpx;
}

.PhotoCover .PhotoDataHead .PhotoItem.avatarStyle image {
   width: 100rpx;
   border-radius: 100rpx;
}

.PhotoCover .PhotoDataHead .PhotoItem.userName {
   color: rgb(231, 231, 231);
   margin-bottom: 5rpx;
   font-size: 36rpx;
   font-weight: bold;
}

.PhotoCover .PhotoDataHead .PhotoItem.Title {
   color: #ffffffab;
   font-size: 22rpx;
   letter-spacing: 5rpx;
}

.PhotoCover image {
   width: 100%;
   height: 35vh;
   position: relative;
}

.PhotoCover image.CoverImage::before {
   content: '';
   width: 100%;
   height: 20%;
   position: absolute;
   bottom: 0;
   left: 0;
   z-index: 100;
   background: linear-gradient(to top, #fff, transparent);
}

.PhotoCover image.CoverImage::after {
   content: '';
   width: 100%;
   height: 100%;
   position: absolute;
   bottom: 0;
   left: 0;
   z-index: 99;
   background: rgba(0, 0, 0, 0.329);
}