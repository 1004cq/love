    position: absolute;
    bottom: 0;
    left: 0;
    background: linear-gradient(to top, #fff, transparent);
} */

.mar_top {
   margin-top: 150rpx;
   padding: 30rpx;
   color: #888;
   font-weight: 300;
}

.avatar {
   position: absolute;
   left: 0;
   top: 0;
   width: 100%;
   height: 100%;
   display: flex;
   align-items: center;
   justify-content: space-around;
}

.boy,
.girl {
   width: 150rpx;
   height: 100%;
   border-radius: 50%;
}

.love {
   width: 100rpx;
   animation: img 2s linear infinite;
}

.aiv_text {
   padding: 8rpx 0;
   color: rgb(255, 255, 255);
   background-color: rgba(77, 73, 73, 0.87);
   border: 2rpx solid #fff;
   border-radius: 100rpx;
   text-align: center;
}

@keyframes img {
   0% {
      transform: scale(0.8, 0.8);
   }

   70% {
      transform: scale(1.3, 1.3);
   }

   100% {
      transform: scale(0.8, 0.8);
   }
}

/* .mian {
   padding-top: 188rpx;
} */

.pad {
   padding: 20rpx 0;
   border-radius: 10rpx;
   background: #f5f5f5;
}

.title_list {
   color: #777;
   font-size: 36rpx;
}

#myAudio {
   display: block;
   width: 100%;
   padding: 20rpx;
   text-align: center;
   box-sizing: border-box;
}

.content {
   font-size: 32rpx;
   color: rgb(78, 78, 78);
   letter-spacing: 2rpx;
   line-height: 50rpx;
}

button[type=default] {
   display: none;
}

.Page_mian {
   padding-bottom: 60rpx;
}

.wxParse-inline.wxParse-a {
   display: none;
}

.AudioCard {
   background: #ffffff8e;
   display: flex;
   border-radius: 20rpx;
   overflow: hidden;
   box-shadow: 0 0px 30px #bfbfbf4a;
   margin: 40rpx auto;
   position: relative;
}

.AudioCard .MusicBackImg{
  position: absolute;
  width: 100%;
  height: 100%;
  top: 50%;
  left: 50%;
  transform: translate(-50%,-50%);
  object-fit: cover;
  /* filter: blur(30rpx);
  -webkit-filter: blur(30rpx); */
}

.AudioCard .left_cont{
   width: 180rpx;
   height: 180rpx;
   position: relative;
}

.AudioCard .left_cont::before{
   content: "";
   position: absolute;
   left: 0;
   top: 0;
   width: 100%;
   height: 100%;
   background-color: #0000001c;
   z-index: 10;
}

.AudioCard .left_cont .BtnPlay{
   position: absolute;
   left: 50%;
   top: 50%;
   width: 60rpx;
   height: 60rpx;
   z-index: 100;
   transform: translate(-50%,-50%);
}

.AudioCard .MusicCover {
   width: 100%;
   height: 100%;
}

.AudioCard .MusicInfo {
   display: flex;
   flex-direction: column;
   justify-content: center;
   /* margin: 0 auto; */
   text-align: center;
   position: relative;
   background: rgb(234 234 234 / 78%);
   width: calc(100% - 180rpx);
   backdrop-filter: blur(30rpx);
   -webkit-backdrop-filter: blur(30rpx);
   transform:translate3d(0,0,0)
}

.AudioCard .MusicInfo .MusicName{
   font-size: 32rpx;
   color: rgb(63, 63, 63);
}

.AudioCard .MusicInfo .MusicAuthor{
   font-size: 22rpx;
   color: rgb(102, 102, 102);
}

.MusicPlayPO{
   width: 130rpx;
   height: 130rpx;
   position: fixed;
   top: 300rpx;
   right: 10rpx;
   z-index: 1000;
}

.MusicPlayPO .cover{
   width: 100%;
   height: 100%;
   border-radius: 50%;
   box-shadow: 0 0px 30px #bfbfbf4a;
}

.CoverAnt{
   animation: CoverRotate 5s linear infinite;
}

.MusicPlayPO .BtnStop{
   position: absolute;
   top: 50%;
   left: 50%;
   width: 60rpx;
   height: 60rpx;
   transform: translate(-50%,-50%);
}

@keyframes CoverRotate {
   from {
     transform: rotate(0deg);
   }
   to {
     transform: rotate(360deg);
   }
 }

 .card_Article{
  margin-top: 20rpx;
  padding-bottom: 10rpx;
  position: relative;
  background: #fff;
 }

 .padding-10{
    padding: 10rpx;
 }

 .content{
    color: #828288;
    font-size: 1rem;
 }