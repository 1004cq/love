:root {
   --background: #8a8a8a;
   --text: #fff;
   --highlight: #448fff;
 }
 
 .theme-switch .left_text,
 .theme-switch .right_text{
   position: absolute;
   top: 50%;
   left: 33px;
   transform: translateY(-50%);
   color: #fff;

 }
 
 .theme-switch .left_text{
   position: absolute;
   left: auto;
   right: 33px;
 }
 
 .theme-switch {
   --background: #fff;
   --text: #333;
   color: var(--text);
   width: 70px;
   height: 30px;
   background: #8a8a8a;
   border-radius: 50px;
   position: relative;
   margin-top: 30rpx;
 }
 
 .theme-switch .switch {
   background: white;
   width: 24px;
   height: 24px;
   background: var(--background);
   border-radius: 100%;
   position: absolute;
   top: 3px;
   left: 4px;
   transition: 0.5s all ease;
   cursor: pointer;
 }
 
 .theme-switch[data-select='true'] {
   background: #448fff;
 }
 
 .theme-switch[data-select='true'] .switch {
   transform: translateX(37px);
 }

.lxy-nav-bar__button {
  opacity: 0;
}

.ipdz {
  font-size: 30rpx !important;
}

.osbr {
  white-space: nowrap;
}

.MsgFooter .UserInfoFooter {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: flex-end;
  flex-wrap: nowrap;
  overflow: auto;
  width: 100%;
}

.MsgFooter .UserInfoFooter .UserInfoItem,
.Msg_Footer .UserInfoItem {
  background: rgba(51, 51, 51, .05);
  color: #666;
  padding: 10rpx;
  border-radius: 10rpx;
  font-size: .85em;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  max-width: 270rpx;
}

.MsgFloatBtn{
  position: fixed;
  top: 33vh;
  right: 20rpx;
  z-index: 100;
}

.MsgFloatBtn text{
  font-size: 66rpx;
  background: #ececec;
  padding: 10rpx;
  border-radius: 20rpx;
  color: #6f6f6f;
  box-shadow: 0 10px 15px -3px rgba(0,0,0,.1),0 4px 6px -4px rgba(0,0,0,.1);
  transition: all .2s;
  border: 1rpx solid #fff;
}

.MsgFloatBtn text:hover{
  background: #525252;
  color: #fff;
  border-color: transparent;
}

.opacity0{
   opacity: 0;
   transition: all .3s;
}