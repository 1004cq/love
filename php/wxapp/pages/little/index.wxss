   content: '';
    width: 100%;
    height: 10%;
    position: absolute;
    bottom: 0;
    left: 0;
    background: linear-gradient(to top, #fff, transparent);
} */

.mar_top {
  margin-top: 150rpx;
  padding: 30rpx;
  color: #888;
  font-weight: 300;
}

.avatar {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.boy,
.girl {
  width: 150rpx;
  height: 100%;
  border-radius: 50%;
}

.love {
  width: 100rpx;
  animation: img 2s linear infinite;
}

.aiv_text {
  padding: 8rpx 0;
  color: rgb(255, 255, 255);
  background-color: rgba(77, 73, 73, 0.87);
  border: 2rpx solid #fff;
  border-radius: 100rpx;
  text-align: center;
}

@keyframes img {
  0% {
    transform: scale(0.8, 0.8);
  }

  70% {
    transform: scale(1.3, 1.3);
  }

  100% {
    transform: scale(0.8, 0.8);
  }
}

.yanji {
  margin-right: 10rpx;
  font-size: 30rpx !important;
}

.cont_text {
  background-color: var(--ghostWhite);
  color: #999;
  padding:23rpx;
  margin: 20rpx 0;
  border-radius: 10rpx;
}
.xianzhi{
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
}
