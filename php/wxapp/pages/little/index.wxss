.main22 {
  /* prettier-ignore */
  height: 400PX;
  height: 100vh;
  background: #eeeeee;
  font-size: 30rpx;
  line-height: 60rpx;
  text-align: center;
}

.nav {
  height: 0;
}
.lxy-nav-bar__button{
  opacity: 0;
}
.img {
  width: 100%;
  height: 500px;
  line-height: 500px;
  color: #fff;
  background-color: #0093E9;
  background-image: linear-gradient(160deg, #0093E9 0%, #80D0C7 100%);

}

.bg_blur {
  width: 100%;
  height: 550rpx;
  position: relative;
}

image.img_css {
  width: 100%;
  height: 100%;
}

.bg_blur_css {
  backdrop-filter: blur(18px);
  background-color: rgba(0, 0, 0, .15);
  background-image: linear-gradient(180deg, transparent 0, hsla(0, 0%, 59%, .1) 20%, hsla(0, 0%, 100%, .2) 40%, hsla(0, 0%, 100%, .6) 60%, #fff);
  height: 100%;
  left: 0;
  position: absolute;
  top: 0;
  width: 100%;
}

.page {
  padding: 30rpx;
  position: relative;
  width: 100%;
  box-sizing: border-box;
}

.top_img {
  margin: 0 auto;
  overflow: hidden;
  border-radius: 30rpx;
  box-shadow: 0 5px 10px #c5c5c585;
}

.baner {
  display: block;
  margin: 0 auto;
  border-radius: 20rpx;
  width: 100%;
  height: 100%;
  position: relative;
}

.baner:before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  /* background: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAAECAYAAACp8Z5+AAAABmJLR0QA/wD/AP+gvaeTAAAACXBIWXMAAAsTAAALEwEAmpwYAAAAKUlEQVQImU3IMREAIAgAwJfNkQCEsH8cijjpMf6vnXlQaIiJFx+omEBfmqIEZLe2jzcAAAAASUVORK5CYII=); */
  background: #0000001f;
}

