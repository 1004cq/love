@import "ColorUI/main.wxss";
@import "ColorUI/icon.wxss";
@import "static/iconfont.wxss";

page {
   --lg-primary: #ff6b8a;
   --lg-secondary: #7468ff;
   --lg-surface: #ffffff;
   --lg-text: #2b2732;
   background: linear-gradient(180deg, #fff7fa 0%, #f6f5ff 100%) !important;
   color: var(--lg-text);
}

.Page_mian {
   padding: 0rpx 30rpx;
   /* padding-top: 40rpx; */
   padding-bottom: 160rpx;
}

.ZindexMax {
   z-index: 100;
}

.Pd-0 {
   padding: 0 !important;
}

.Pd-t-10{
   padding-top: 10rpx !important;
}

.cu-bar.tabbar .action.add-action::after {
   background: #ffffff91;
   border: 6rpx solid #fff;
   border-radius: 50%;
}

.card {
   padding-top: 50rpx;
   padding-bottom: 10rpx;
   position: relative;
   background: #fff;
   box-shadow: 0 18rpx 60rpx rgba(74, 55, 100, .10);
   border: 1rpx solid rgba(60, 48, 80, .08);
   border-radius: 28rpx;
   margin: 30rpx 0;
}

.card::before {
   content: '';
   display: inline-block;
   width: 12px;
   height: 12px;
   border-radius: 50%;
   background-color: #fd6458;
   box-shadow: 20px 0 0 #ffbf2b, 40px 0 0 #24cc3d;
   position: absolute;
   left: 30rpx;
   top: 28rpx;
}

.top_30 {
   margin-top: 30rpx;
}

.radius_20 {
   border-radius: 14rpx;
   box-shadow: 0 3px 11px #a59c9c57;
}

.cu-list.menu-avatar>.cu-item .content .cu-tag.sm {
   height: 30rpx;
   font-size: 16rpx;
   line-height: 32rpx;
   font-weight: 300;
   background: #888;
}

.bg-whiteyy {
   background: #fff;
   border-radius: 10rpx;
   background-image: var(--gradualBlue);
   color: var(--white);
}



.text-orange {
   color: #fff;
}

.flex_1 {
   flex: 1;
}

.nav_url {
   padding: 30rpx 40rpx;
   background: rgb(231, 231, 231);
   border-radius: 15rpx;
   background: linear-gradient(135deg, var(--lg-primary), var(--lg-secondary));
   color: var(--white);
   display: flex;
   justify-content: center;
   align-items: center;
   font-weight: 300;
}

.icon_max {
   display: inline-block;
   font-size: 50rpx !important;
   margin-right: 10rpx;
}

.nav {
   height: 0;
}

.wxParse-hr {
   border: none;
   border-top: 2rpx dashed rgb(184, 181, 181);
   margin: 30rpx auto;
   display: block;
}

.wxParse-quote {
   padding: 20rpx 0px 20rpx 20rpx;
   width: 100%;
   display: block;
   color: #fff;
   background-color: #545454;
   border-radius: 15rpx;
   letter-spacing: 1px;
   margin: 40rpx 0;
   font-size: 1.1em;
   position: relative;
   padding-left: 40rpx;
   box-shadow: 0 0 30rpx rgba(73, 73, 73, 0.295);
}

.wxParse-quote::before {
   content: "";
   position: absolute;
   width: 6rpx;
   height: 60%;
   top: 50%;
   left: 20rpx;
   border-radius: 20rpx;
   background-color: #ffffff;
   transform: translate(-50%, -50%);
}

.p.wxParse-view {
   text-indent: 2em;
}

.h1.wxParse-view {
   font-size: 1.1em;
   line-height: 1.3rem;
   margin: 1rem 0;
   color: #03A9F4;
   padding: 20rpx;
   letter-spacing: 1px;
   border-left: 4px solid #03A9F4;
   border-radius: 0.3rem;
   background: #f8f8f8;
}

.wxParse-pre {
   display: none;
}


.h2.wxParse-view {
   font-size: 1.1em;
   line-height: 2rem;
   margin: 1rem 0;
   color: #ff9554;
   letter-spacing: 1px;
   position: relative;
   padding: 20rpx;
   border-radius: 0.3rem;
   background: #f8f8f8;
}

.h2.wxParse-view::before {
   content: "";
   display: inline-block;
   width: 3rem;
   height: 0.4rem;
   position: absolute;
   top: 0.2rem;
   border-radius: 1rem;
   left: 2px;
   background-color: #FF820C;
   box-shadow: 1px 1px 10px #ffa34c66;
}



.h3.wxParse-view,
.h4.wxParse-view {
   font-size: 1.1em;
   line-height: 1.5rem;
   margin: 1rem 0;
   color: #373737;
   letter-spacing: 1px;
   position: relative;
   padding-left: 0.5rem;
   border-bottom: 1px solid #c1bcbc;
}


.h4.wxParse-view {
   border-bottom: 1px dashed #a09999;
}

.h5.wxParse-view,
.h6.wxParse-view{
   font-size: 1.1em;
   line-height: 1.3em;
   margin: 1rem 0;
   color: #423e3e;
   letter-spacing: 1px;
   position: relative;
   padding-left: 30rpx;
}

.h5.wxParse-view:before {
   position: absolute;
   top: 50%;
   left: 0;
   content: "";
   width: 8rpx;
   transform: translateY(-50%);
   height: 100%;
   border-radius: 10rpx;
   background-color: #006eff;
   box-shadow: 1px 0px 10px -1px #006eff;
}

.h6.wxParse-view{
   color: #6e6666;
   padding: 0;
}

.wxParse-li-text .wxParse-inline{
   display: inline-flex;
}

.wxParse-li {
   font-size: .9em;
   list-style-type: disc;
   position: relative;
   padding-left: 30rpx;
}

.wxParse-li::before {
   content: "";
   top: 24rpx;
   left: 0;
   position: absolute;
   width: 12rpx;
   height: 12rpx;
   background-color:rgb(87, 87, 87);
   border-radius: 50%;
 }

.blod.wxParse-text {
   font-family: 'Noto Serif SC', serif;
   font-weight: bold;
   color: #222121;
   font-style: normal;
   font-size: 32rpx;
   margin: 0 6rpx;
   display: inline-block;
}

.shanchu.wxParse-text {
   display: inline-block;
   text-decoration: line-through;
   color: #adadad;
   text-indent: 0;
}

.xie.wxParse-text {
   display: inline-block;
   font-style: italic;
   margin: 10rpx 6rpx;
   font-size: .9em;
}

.wxParse-center {
   text-align: center;
}

.wxParse-img {
   border-radius: 18rpx;
   box-shadow: 0 3px 11px #a59c9c57;
   margin: 10rpx auto;
   margin-bottom: 20rpx;
   display: block;
}

.wxParse-video-video {
   border-radius: 18rpx;
   box-shadow: 0 3px 11px #a59c9c57;
   margin: 20rpx auto;
   width: 100%;
   margin-bottom: 18rpx;
}

.cu-card.dynamic {
   position: relative;
}

.cu-card.dynamic .ClickRight {
   position: absolute;
   top: 10rpx;
   right: 50rpx;
   background-color: rgb(236, 236, 236);
   padding: 15rpx;
   box-sizing: border-box;
   z-index: 10;
   border-radius: 20rpx;
   transition: all 0.2s;
}

.cu-card.dynamic .ClickRight:hover {
   background: #0081ff;
   color: #fff;
}

.right_btn {
   text-align: right;
}

.cu-btn {
   font-weight: 300;
}

/* .mian {
   padding-top: 188rpx;
} */

.mgr_r {
   margin-right: 20rpx;
}

.cont_text {
   background-color: var(--ghostWhite);
   color: #999;
   padding: 23rpx;
   margin: 20rpx 0;
   border-radius: 10rpx;
   word-break: break-all;
}

.xianzhi {
   display: -webkit-box;
   overflow: hidden;
   -webkit-box-orient: vertical;
   -webkit-line-clamp: 3;
}


.wxParse-p view {
   text-indent: 2em;
}

.cu-modal input,
.cu-modal input::placeholder {
   border-bottom: 2rpx solid rgb(216, 216, 216);
   transition: all 0.3s;
   min-height: 80rpx;
   padding: 20rpx;
   margin: 28rpx 0;
   background: #ffffff;
   color: #555;
   width: 100%;
   box-sizing: border-box;
}

.cu-modal input:hover,
.cu-modal input:active,
.cu-modal input:focus {
   border-color: #292929;
   color: #292929;
}

.center-cont {
   text-align: center;
}


.TopRefresh {
   position: fixed;
   top: 200rpx;
   right: 20rpx;
   z-index: 999;
   background: #03A9F4;
   width: 70rpx;
   height: 70rpx;
   display: flex;
   align-items: center;
   justify-content: center;
   border-radius: 20rpx;
   box-shadow: 0 5px 15px #c9c9c985;
   color: #fff;
   border: 2rpx solid #fff;
   box-sizing: border-box;
   font-size: 1.8em;
}

.TopRefresh:hover {
   background-color: #fff;
   color: #03A9F4;
}

.wxParse-center .wxParse-p view {
   text-indent: 0;
}

.LoveTitle {
   position: fixed;
   top: 0;
   left: 50%;
   z-index: 999;
   transform: translate(-50%, -50%);
}

.LoveTitle text {
   display: inline-block;
   width: 100%;
   height: 100%;
   padding: 10rpx 30rpx;
   border-radius: 100rpx;
   backdrop-filter: blur(15px);
   -webkit-backdrop-filter: blur(15px);
   border: 2rpx solid #fff;
   box-shadow: 0 0 24rpx rgba(0, 0, 0, .06);
   background: rgb(255 255 255 / 0.85);
   color: #403f3f;
   font-weight: bold;
   font-size: 28rpx;
}

.wxParse-p .wxParse-wxxxcode-style .WxEmojiView,
.shanchu {
   text-indent: 0em !important;
   line-height: 1.3em;
}

.wxParse-p .wxParse-wxxxcode-style {
   display: inline-block;
   padding: 5rpx 10rpx;
   line-height: 1.3em;
   border-radius: 12rpx;
   font-size: 26rpx;
   color: #fa5c7c;
   background-color: rgba(255, 132, 157, 0.18);
   text-indent: 0em !important;
}

.wxParse-p .wxParse-inline {
   display: contents;
}

.wxParse-p {
   text-indent: 2em;
   font-size: .9em;
}

.wxParse-desc{
   position: relative;
   padding: 30rpx;
   line-height: 1.7em;
   background: #f5f5f5;
   border-radius: 10px;
   color: #747474;
   display: block;
   margin: 30rpx 0;
   text-indent: 2em;
   font-size: .9em;
   font-weight: normal;
}

.wxParse-desc::before {
   content: "“";
   position: absolute;
   font-size: 150rpx;
   color: #b9b9b9;
   top: 20rpx;
   left: 20rpx;
   font-family: Georgia, serif;
   text-indent: 0;
}

.wxParse-i{
   font-style: italic;
   color: rgb(99, 99, 99);
   font-size: .9em;
}

.wxParse-s{
   text-decoration: line-through;
   -webkit-text-decoration: line-through;
   color: #ff746a;
   font-size: .9em;
}

.wxParse-wxxxcode-style{
   background-color: #008cff;
   border-radius: 10rpx;
   color: #fff;
   font-size: .85em;
   padding: 0 10rpx;
   display: inline-flex;
}


/* 弹出层样式 */

.popbg {
   position: fixed;
   top: 0;
   left: 0;
   width: 100%;
   height: 100%;
   background: #ffffffb8;
   backdrop-filter: blur(20px);
   -webkit-backdrop-filter: blur(20px);
   transition: all .3s;
   z-index: 998;
 }
 
 .popup {
   position: fixed;
   bottom: 0;
   left: 0;
   width: 100%;
   height: 70vh;
   background: #ededed;
   border-radius: 50rpx 50rpx 0 0;
   padding: 50rpx;
   box-sizing: border-box;
   /* box-shadow: 0 -10px 15px -3px rgba(168, 168, 168, 0.1); */
   z-index: 10000;

 }
 
 .popup .pop_Title{
   font-size: 46rpx;
   color: rgb(97, 97, 97);
   padding-bottom: 20rpx;
   border-bottom: 2rpx solid #d6d6d6;
   font-style: normal;
   font-weight: normal;
   font-variant: normal;
   text-transform: none;
   line-height: 1;
   -webkit-font-smoothing: antialiased;
   -moz-osx-font-smoothing: grayscale;
 }

 .popup .pop_Title text{
   margin-right: 10rpx;
 }

 .popup .popCloseBtn{
    position: absolute;
    right: 60rpx;
    font-size: 45rpx;
    top: 43rpx;
 }

 .popup .MsgHead{
    display: flex;
 }

 .popup .get_qqInfo{
    position: relative;
 }

 .popup .get_qqInfo .getqqInfoBtn{
    position: absolute;
    z-index: 100;
    right: 10rpx;
    top: 50%;
    background: #ededed;
    padding: 16rpx;
    border-radius: 100rpx;
    transform: translateY(-50%);
    transition: all .3s;
 }

 .popup .get_qqInfo .getqqInfoBtn:hover{
   background: #333;
   color: #fff;
 }

 .popup .Msg_Footer{
    display: flex;
    justify-content: space-between;
    align-items: center;
 }

 .popup .Msg_Footer .RandomQuote{
    border: 1rpx solid rgb(134, 134, 134);
    padding: 10rpx 20rpx;
    border-radius: 10rpx;
    color: rgb(134, 134, 134);
    transition: all .3s;
 }

 .popup .Msg_Footer .hide{
    opacity: 0;
 }
 
 .popup .Msg_Footer .UserInfoItem{
    background: rgb(255 255 255 / 83%);
 }

 .popup .Msg_Footer .RandomQuote:hover{
    background: #333;
    color: #fff;
    border-color: #333;
 }

 .popup .MsgHead .UserAvatar image{
    width: 100rpx;
    border-radius: 20rpx;
    background: #ffffff;
 }
 
 .popup .pop_Form input,
 .popup .pop_Form textarea{
   min-height: 80rpx;
   padding: 20rpx;
   margin: 28rpx 0;
   background: #ffffff;
   border-radius: 20rpx;
   color: #555;
   width: 100%;
   box-sizing: border-box;
 }
 

.popup .pop_Form .Flex-Layout{
   display: flex;
 }
 
 .popup .pop_Form .Submit{
   margin-top: 40rpx;
   background: #313131;
   font-weight: 400;
   font-size: 38rpx;
   letter-spacing: 5rpx;
   transition: all .3s;
 }

 .popup .pop_Form .Submit:hover{
    background: #fff;
    color: #333;
 }
 
 .popup .pop_Form .GreyBtn{
   background: #e1e1e1;
 }
 
 .popup .pop_Form .Submit,
 .popup .pop_Form .GreyBtn{
   padding: 26rpx !important;
   line-height: 1.2;
   border-radius: 100rpx;
 }
 

 
 /* 弹出层显示动画 */
 @keyframes fadeIn {
   0% {
     opacity: 0;
   }
   100% {
     opacity: 1;
   }
 }
 
 @keyframes slideDown {
   0% {
     transform: translate(-50%, -100%);
     opacity: 0;
   }
   100% {
     transform: translate(-50%, -50%);
     opacity: 1;
   }
 }

 /* 弹出层关闭动画 */
 @keyframes fadeOut {
   0% {
     opacity: 1;
   }
   100% {
     opacity: 0;
   }
 }
 
 @keyframes slideUp {
   0% {
     transform: translate(-50%, -50%);
     opacity: 1;
   }
 
   100% {
     transform: translate(-100%, -50%);
     opacity: 0;
   }
 }
 
 /* 动画类 */
 .fadeIn {
   animation: fadeIn 0.3s forwards;
 }
 
 .slideDown {
   animation: slideDown 0.3s ease-out forwards;
 }
 
 .fadeOut {
   animation: fadeOut 0.5s forwards;
 }
 
 .slideUp {
   animation: slideUp 0.3s ease-out forwards;
 }

 .dialogBtn{
   padding: 42rpx;
   font-size: 34rpx;
   border-radius: 55rpx;
 }
