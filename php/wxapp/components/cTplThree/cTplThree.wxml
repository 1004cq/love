<view class="animation_wrapper">
  <view class="animation animation_center"></view>
  <view class="animation animation_left"></view>
  <view class="animation animation_right"></view>
</view>

<view class="headArea-warp">
  <view class="loversInfo-Area">
    <view class="boyInfo">
      <image class="Info-avatar" src="{{LoversData.if_aiv == 1 ? LoversData.diyb_url : LoversData.boyimg}}" mode="widthFix" />
      <view class="Info-name">{{LoversData.boy}}</view>
    </view>
    <view class="girlInfo">
      <image class="Info-avatar" src="{{LoversData.if_aiv == 1 ? LoversData.diyg_url : LoversData.girlimg}}" mode="widthFix" />
      <view class="Info-name">{{LoversData.girl}}</view>
    </view>
  </view>
</view>

<view class="mainContentArea">

  <view class="warningInfo">
    <text class="iconfont icon-mima"></text>
    本页面展示的所有数据均为静态，无法进行编辑、生成操作，仅作为纪念展示。
  </view>
  <view class="Time-Card">
    <view class="Time-Cont">
      <view class="Time-Title">
        <text class="iconfont icon-jiantouarrow591"></text>
        {{LoversData.loveDayTitle}}
      </view>
      <view class="Time-Text"> 第<text class="Time-Day">{{LoversData.startTime}}</text>天</view>
    </view>
  </view>

  <view class="nodeTitle">
    <text class="iconfont icon-AppIcon"></text>
    记录生活
  </view>

  <view class="Diary-List-Card" wx:for="{{4}}" wx:for-index="index" wx:key="*this">
    <view class="List-Cont" bindtap="handleItemTap" data-title="{{LoversData.sample_title}}" data-content="{{LoversData.sample_description}}" data-time="{{currentTime}}" data-cover="{{LoversData.test_cover}}">
      <view class="List-Cover" style="background: url({{LoversData.test_cover}}) no-repeat center;background-size: cover;">
      </view>
      <view class="List-Info">
        <view class="List-Info-Title">
          {{LoversData.sample_title}}
        </view>
        <view class="List-Info-Desc">
          {{LoversData.sample_description}}
        </view>
        <view class="List-Footer-Info">
          <view class="Author">
            <image class="Author-avatar" src="{{index % 2 === 0  ? (LoversData.if_aiv == 1 ? LoversData.diyb_url : LoversData.boyimg) : (LoversData.if_aiv == 1 ? LoversData.diyg_url : LoversData.girlimg) }}" mode="widthFix" />
            <text class="Author-name">{{index % 2 === 0 ? LoversData.boy : LoversData.girl}}</text>
          </view>
          <view class="ReleaseTime">
            {{currentTime}}
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="nodeTitle">
    <text class="iconfont icon-AppIcon"></text>
    赠送清单
  </view>

  <view class="New-List-Card" wx:for="{{CtplTowData}}" wx:for-item="item" wx:for-index="index" wx:key="*this">
    <view class="List-Cont">
      <view class="List-Info">
        <view class="List-Info-Title">
          {{item.title}}
        </view>
        <view class="List-Info-Desc">
          <view class="List-Info-Tag-Item" wx:for="{{item.tags}}" wx:for-item="item" wx:for-index="index" wx:key="*this">
            {{item}}
          </view>
        </view>
        <view class="List-Footer-Info">
          <view class="itemPrice">
            <text>¥{{item.price}}</text>/元
          </view>
          <view class="Author">
            <text class="font-min">赠送人：</text>
            <image class="Author-avatar" src="{{index % 2 === 0  ? (LoversData.if_aiv == 1 ? LoversData.diyb_url : LoversData.boyimg) : (LoversData.if_aiv == 1 ? LoversData.diyg_url : LoversData.girlimg) }}" mode="widthFix" />
            <text class="Author-name">{{index % 2 === 0 ? LoversData.boy : LoversData.girl}}</text>
          </view>
          <view class="ReleaseTime">
            {{currentTime}}
          </view>
        </view>
      </view>
      <view class="List-Cover" style="background: url({{item.cover}}) no-repeat center;background-size: cover;">
      </view>
    </view>
  </view>

  <view class="nodeTitle">
    <text class="iconfont icon-AppIcon"></text>
    关于我们的故事
  </view>

  <view class="chatRecord">
    <view class="List-Head-warp">
      <text class="iconfont icon-nicheng1"></text>
      <text class="chatRecord-User-Name">{{chatUserName}}</text>
    </view>
    <view class="List-Card leftMessage" wx:for="{{CtplThreeData}}" wx:for-item="item" wx:for-index="index" wx:key="*this">
      <view class="List-Cont">

        <block wx:if="{{item.type === 1}}">
          <view class="List-Item List-Item-left">
            <view class="List-Item-avatar">
              <image src="{{LoversData.if_aiv == 1 ? LoversData.diyb_url : LoversData.boyimg}}" mode="widthFix" />
            </view>
            <view class="List-Item-text">
              {{item.content}}
            </view>
          </view>
        </block>

        <block wx:elif="{{item.type === 2}}">
          <view class="List-Item List-Item-right">
            <view class="List-Item-avatar">
              <image src="{{LoversData.if_aiv == 1 ? LoversData.diyg_url : LoversData.girlimg}}" mode="widthFix" />
            </view>
            <view class="List-Item-text">
              {{item.content}}
            </view>
          </view>
        </block>

      </view>
    </view>
  </view>

</view>