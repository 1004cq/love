generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// Dual admins — PHP `login` 男主/女主
model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  displayName  String
  avatarUrl    String?
  createdAt    DateTime       @default(now())
  photos       AlbumPhoto[]
  diaries      DiaryEntry[]
  messages     Message[]
  together     TogetherItem[]
}

/// PHP `text` 站点/情侣配置
model SiteConfig {
  id              Int      @id @default(1)
  boy             String   @default("My Name")
  girl            String   @default("My Name")
  title           String   @default("LG_NewUi")
  logo            String   @default("LG_Demo")
  writing         String   @default("小手一牵 岁岁年年～")
  boyAvatar       String?
  girlAvatar      String?
  startTime       DateTime
  loveDayTitle    String   @default("这是我们一起走过的")
  card1           String   @default("点点滴滴")
  card2           String   @default("祝福留言")
  card3           String   @default("恋爱相册")
  card4           String   @default("恋爱事件")
  deci1           String   @default("记录生活点点滴滴")
  deci2           String   @default("书写下你的留言祝福～")
  deci3           String   @default("记录下美好瞬间～")
  deci4           String   @default("总有些惊奇的际遇")
  icp             String?
  copyright       String   @default("LG_NewUi Web")
  siteDescription String?
  updatedAt       DateTime @updatedAt
}

/// Keep Setting for backward-compatible start date sync
model Setting {
  id                  Int      @id @default(1)
  relationshipStartAt DateTime
  updatedAt           DateTime @updatedAt
}

/// PHP `loveImg` / Photolist 简化
model AlbumPhoto {
  id           String   @id @default(cuid())
  url          String
  caption      String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

/// PHP `article` — 点点滴滴
model DiaryEntry {
  id        String   @id @default(cuid())
  title     String
  content   String
  imageUrl  String?
  weather   String   @default("sunny")
  mood      String   @default("happy")
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// PHP `loveday`
model Anniversary {
  id          String   @id @default(cuid())
  title       String
  date        DateTime
  note        String?
  isImportant Boolean  @default(false)
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
}

/// PHP `leaving` — 祝福留言
model Message {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// PHP `lovelist` — 恋爱事件
model TogetherItem {
  id          String    @id @default(cuid())
  title       String
  note        String?
  isCompleted Boolean   @default(false)
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  completedAt DateTime?
}

model MusicTrack {
  id        String   @id @default(cuid())
  title     String
  artist    String?
  url       String
  coverUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
